# Keep the application source; local business materials remain outside Git.
/*
!/.gitignore
!/*.py
!/*.pyw
!/config.json
!/README.md
!/LICENSE
!/CONTRIBUTING.md
!/SECURITY.md
!/requirements*.txt
!/docs/
!/scripts/
!/sources/
!/sources/video-cases/
!/sources/video-cases/case_template.md
!/sources/README.md
!/examples/
!/.github/
!/使用说明.md
!/static/
!/tests/
!/deployment/

__pycache__/
*.py[cod]
.pytest_cache/
node_modules/
.wrangler/
.text-site-build-*/
.env*
.dev.vars*
*.log
*.new
config.local.json
.venv/
.local/
*.sqlite*
*.db
*.pem
*.key

# Only the source template is publishable; case documents remain private.
/sources/*
!/sources/README.md
!/sources/video-cases/
/sources/video-cases/*
!/sources/video-cases/case_template.md

# Generated exports, snapshots, and deployment screenshots.
/deployment/site/
/deployment/*.zip
/deployment/*.jpg
/deployment/*.png
/deployment/deployment-result.json
/deployment/export-report.json
/deployment/text-snapshot.json
